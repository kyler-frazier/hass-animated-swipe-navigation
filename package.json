{
  "name": "hass-animated-swipe-navigation",
  "version": "0.1.1",
  "private": true,
  "description": "Swipe between Home Assistant dashboard views, with a liquid bubble that follows your finger.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hass:up": "docker compose up -d --wait",
    "hass:down": "docker compose down --volumes",
    "test": "playwright test",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
